# Product mapping for the shared package index.
# Add one file per tool; the update workflow sources it by product name.

PRODUCT_REPO=bytecapsule/doscapsule
FORMULA=Formula/doscapsule.rb
SCOOP=bucket/doscapsule.json

# Release asset prefixes; the tag is appended as "<asset>-<tag>.zip".
MACOS_ARM_ASSET=doscapsule-macos-arm64
MACOS_X64_ASSET=doscapsule-macos-x64
WINDOWS_ASSET=doscapsule-windows-x64
